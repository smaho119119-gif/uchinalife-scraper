# 本番は GitHub Secrets に同じ名前で登録する（このファイルに値を書かない）

# 物件データ（Supabase）
SUPABASE_URL=
SUPABASE_ANON_KEY=
STORAGE_SUPABASE_URL=
STORAGE_SUPABASE_KEY=

# PROPERTY AI（AI相場推定）への同期
PROPERTY_AI_URL=
PROPERTY_AI_KEY=
PROPERTY_AI_SYNC_TOKEN=

# 実行の記録（管理ページの取得履歴。uchina_log_scrape_run の合言葉）
UCHINA_RUN_LOG_TOKEN=

# 公開サイト（fudosan.nextcode.ltd）の作り直し。Vercel の REVALIDATE_TOKEN と同じ値（README「公開サイトの作り直し」）
FUDOSAN_REVALIDATE_TOKEN=
# FUDOSAN_SITE_URL=https://fudosan.nextcode.ltd   # 省略可

# メール（mail-relay 経由が既定。SMTP は中継が使えないときの予備）
MAIL_RELAY_URL=
MAIL_RELAY_TOKEN=
ALERT_TO=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=
